# Pick the provider used by your default model. Examples: deepseek, ollama,
# openai, anthropic, google_genai
MODEL_PROVIDER=deepseek

# The model identifier is provider-specific. Examples:
# deepseek: deepseek-chat
# ollama: llama3.2 (ensure the model is pulled locally)
# openai: gpt-4o-mini
# anthropic: claude-3-5-sonnet-latest
# google_genai: gemini-2.0-flash
MODEL=deepseek-chat
TEMPERATURE=0.7

# Add only the key for the provider you use. Keep this file private.
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
